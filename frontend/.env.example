# Copy to .env.local (never commit it). Values are for local development only.

# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000

AUTH_KEYCLOAK_ID=tabletalk-web
# Matches keycloak/realm-tabletalk.json (dev-only secret).
AUTH_KEYCLOAK_SECRET=dev-only-tabletalk-web-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/tabletalk

# Go API, called from the Next.js server only.
API_BASE_URL=http://localhost:8081

