# Copy to .env (never commit .env). All values below are for local development only.

# --- Docker Compose ---
POSTGRES_USER=tabletalk
POSTGRES_PASSWORD=tabletalk
POSTGRES_DB=tabletalk
POSTGRES_PORT=5432
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
MAILPIT_UI_PORT=8025

# --- Go API ---
HTTP_ADDR=:8081
DATABASE_URL=postgres://tabletalk:tabletalk@localhost:5432/tabletalk?sslmode=disable
TEST_DATABASE_URL=postgres://tabletalk:tabletalk@localhost:5432/tabletalk_test?sslmode=disable
OIDC_ISSUER_URL=http://localhost:8080/realms/tabletalk
OIDC_AUDIENCE=tabletalk-api
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8081
